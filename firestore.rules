rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // A "known user" is a signed-in account with a Firestore profile that
    // isn't sitting in the pending-approval queue. Self-registered nurse/
    // doctor accounts (see /request-account) are created with
    // status: 'pending' and stay locked out of every collection gated by
    // isKnownUser() until an admin approves them (status becomes
    // 'approved') or removes the status field entirely — accounts created
    // the old way (Admin > Create Account) never had a status field, and
    // .get(field, default) treats that the same as 'approved' so nothing
    // about them changes.
    function isKnownUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'approved') != 'pending';
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSubadmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    // Records staff (role 'record') — may write the Records summary page.
    function isRecord() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'record';
    }
    // The nurse currently holding the Overall Nurse role for a given week
    // (see /nurseReportRoles/{weekId}) — used to gate first-time archiving.
    function isOverallForWeek(wid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/nurseReportRoles/$(wid))
        && get(/databases/$(database)/documents/nurseReportRoles/$(wid)).data.overallNurse.uid == request.auth.uid;
    }
    // Same check as isOverallForWeek() above, but against MHL's own
    // nurseReportRoles_mhl collection — see the "MILITARY HOSPITAL LAGOS
    // (MHL) app" block below for what MHL keeps separate from 68 and what
    // it shares.
    function isOverallForWeekMhl(wid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/nurseReportRoles_mhl/$(wid))
        && get(/databases/$(database)/documents/nurseReportRoles_mhl/$(wid)).data.overallNurse.uid == request.auth.uid;
    }

    // User profiles / roles
    match /users/{uid} {
      // A pending applicant needs to read her OWN doc to find out she's
      // still pending (see AuthContext.jsx / RequireAuth.jsx's waiting
      // screen), even though isKnownUser() above now excludes her — so
      // self-read is allowed unconditionally, but reading anyone else's
      // profile still requires being an approved, known user.
      allow read: if isKnownUser() || (isSignedIn() && request.auth.uid == uid);
      // Admins create fully-approved accounts directly (Admin > Create
      // Account). Anyone else may only create her OWN doc, as a pending
      // application from /request-account — self-selecting only 'nurse'/
      // 'doctor', never 'admin'/'subadmin', always status 'pending' (never
      // pre-approved), and with an email that matches the Auth account she
      // just created (no impersonating another address).
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.role in ['nurse', 'doctor', 'record'] &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.email == request.auth.token.email
        )
      );
      // Admins can update anything — including approving a pending
      // application (status: 'pending' -> 'approved') and confirming/
      // changing the role on approval. A signed-in user may also edit her
      // own profile (phone, gender, ward, etc.) but may not change her own
      // role, email, name, or approval status through this path — those
      // need an admin, same reasoning as before, now extended to status so
      // a pending applicant can never self-approve.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved')
      );
      allow delete: if isAdmin();

      // Push tokens for drug-due alerts (js/push.js). A nurse manages only
      // her own device tokens; the alert Cloud Function reads across all
      // users via the Admin SDK, which bypasses these rules entirely.
      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Drug-due alarm policy (sound/appearance/repeat/quiet-hours/frequencies)
    // set by an admin in admin.html and applied on every device in
    // js/push.js. Any signed-in user needs read access — it's their own
    // device's alarm behavior that depends on it — but only an admin may
    // change ward-wide alarm policy.
    match /settings/{settingId} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }

    // Patient allocation ("Allocate to Me" / My Patients) — any known user
    // may read the list, but a nurse may only create/update/delete her own
    // allocation docs — never allocate or deallocate on someone else's behalf.
    match /allocations/{allocationId} {
      allow read: if isKnownUser();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Ward-wide community feed (Community page) — a single shared board any
    // signed-in staff member can post to and read. Author name/gender are
    // denormalized onto each post at write time so the feed never needs a
    // users/ lookup per post. A post may only be edited/deleted by the
    // nurse who wrote it — never by another nurse, not even an admin.
    match /communityPosts/{postId} {
      allow read: if isKnownUser();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Replies on a post. Same authorship rule as the post itself — only
      // the comment's own author may edit or remove it.
      match /comments/{commentId} {
        allow read: if isKnownUser();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Ward-name overrides, column-label overrides, and admin-added custom
    // columns for the Nurses Report tables — any known user reads it (it
    // drives what's shown on the Overall Statistics table and every ward
    // report), but only an admin may change the structure.
    match /nurseReportConfig/{configId} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }

    // Nurses Report — the weekly Overall Nurse assignment, and each day's
    // 24-hour ward census. Any known user may claim/hand off the Overall
    // Nurse role or edit ward figures — the app itself gates who sees the
    // Overall Nurse page, matching how admin-only UI is gated elsewhere
    // without every collection needing its own role check here.
    match /nurseReportRoles/{weekId} {
      allow read: if isKnownUser();
      // Only an admin/subadmin appoints the week's Overall Nurse — nurses
      // can no longer claim the role themselves.
      allow write: if isAdmin() || isSubadmin();
    }
    match /nurseReports/{dateId} {
      allow read, write: if isKnownUser();

      match /wards/{wardKey} {
        allow read, write: if isKnownUser();
      }
    }

    // Records page — the daily "Summary Breakdown of Statistics" sheet
    // (one doc per date, keyed YYYY-MM-DD) compiled by records staff.
    // Any known user may read; only record staff, admin or subadmin write.
    match /recordSummaries/{dateId} {
      allow read: if isKnownUser();
      allow create, update: if isKnownUser() && (isAdmin() || isSubadmin() || isRecord());
      allow delete: if isAdmin();
    }

    // Ward Charts Archive — the finalized, permanent daily record. One
    // "overall_<dateId>" doc plus one "ward_<wardKey>_<dateId>" doc per
    // ward are created together (see nurses-report/overall-nurse.html's
    // Save to Archive action). Any known user may read/search the
    // archive. Only the Overall Nurse for the report's week (checked via
    // the weekId carried on the write itself), an admin, or a subadmin
    // may create an archive entry the first time; once it exists, only an
    // admin or subadmin may change it (correcting a figure or note) — even
    // the Overall Nurse who filed it cannot edit it afterwards. Archive
    // files are permanent: delete is never allowed, by anyone.
    match /archives/{archiveId} {
      allow read: if isKnownUser();
      allow create: if isKnownUser()
        && (isAdmin() || isSubadmin() || isOverallForWeek(request.resource.data.weekId));
      allow update: if isAdmin() || isSubadmin();
      allow delete: if false;
    }

    // Nurse-to-nurse messaging (Messages page) — both direct 1:1 chats and
    // group chats live in the same conversations collection, distinguished
    // by `type: 'dm' | 'group'`. `participants` is the source of truth for
    // access on both: only the people in it may read/write the conversation,
    // its messages, or its typing indicators — nobody else, including
    // admins, can see private chats. DMs use a deterministic doc id
    // ("dm_{sortedUidA}_{sortedUidB}") so the same pair always lands on the
    // same thread; groups use an auto-generated id since membership isn't a
    // fixed pair. `readBy` (a map of uid -> last-read timestamp) drives read
    // receipts, updated by each participant for their own uid only.
    match /conversations/{convoId} {
      // resource is null when the doc doesn't exist yet (startChat()'s
      // getDoc() check before the first message between two nurses) — there's
      // no data to protect in that case, so let the existence check through;
      // once the doc exists, only its participants may read it.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && (request.resource.data.type == 'dm' ? request.resource.data.participants.size() == 2 : true)
        && (request.resource.data.type == 'group' ? request.resource.data.createdBy == request.auth.uid : true);
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && (
        // Updating the shared "last message" preview shown in the chat list.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText', 'lastMessageAt', 'lastMessageSenderUid'])
        ||
        // Marking messages read — a participant may touch only her own key
        // in the readBy map, never anyone else's read timestamp.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
        )
        ||
        // Group membership/name changes — creator-managed only, and only
        // for groups; a DM's participants/type can never be altered.
        (
          resource.data.type == 'group' && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.type == resource.data.type
        )
      );
      allow delete: if false;

      // Per-user "is typing" flag. Anyone in the conversation can see who's
      // typing, but each nurse may only write her own typing doc.
      match /typing/{uid} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow write: if isSignedIn() && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
          && request.resource.data.senderUid == request.auth.uid;
        // A message's own sender may edit/delete it outright. Any other
        // participant may still touch the doc, but ONLY to add/remove her
        // own reaction or toggle her own star — never the text, image, or
        // anyone else's content.
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
          && (
            resource.data.senderUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'starredBy'])
          );
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    // Patients and every chart subcollection under them
    match /patients/{patientId} {
      allow read, create, update: if isKnownUser();
      allow delete: if isAdmin();

      match /{chartCollection}/{chartDoc} {
        allow read, create, update, delete: if isKnownUser();
      }
    }

    // ---------------------------------------------------------------
    // MILITARY HOSPITAL LAGOS (MHL) app — same Firebase project as 68,
    // and the same shared /patients records (a patient's demographics
    // and every chart — drug course, vitals, blood glucose, intake &
    // output, seizure — are one record either hospital reads/writes,
    // covered by the /patients rule above). What's kept separate is only
    // *which ward a patient is currently placed on*: MHL writes that to
    // its own wardMhl/pendingTransferMhl/pedBedTypeMhl fields on the same
    // patient doc instead of 68's ward/pendingTransfer/pedBedType, so a
    // patient can be on a ward in one hospital's app and unplaced (shows
    // only in a name/EMR search, not on any ward list) in the other's,
    // until a nurse there transfers them onto one. No extra Firestore
    // rule is needed for that — it's just different field names within
    // the same /patients read/write rule above.
    //
    // Ward allocations, the ward-report archive, and nurse-report/
    // overall-nurse do still get their own MHL-only collections below,
    // each mirroring the access rule of its 68 counterpart.
    // ---------------------------------------------------------------

    match /allocations_mhl/{allocationId} {
      allow read: if isKnownUser();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /nurseReportRoles_mhl/{weekId} {
      allow read, write: if isKnownUser();
    }
    match /nurseReports_mhl/{dateId} {
      allow read, write: if isKnownUser();

      match /wards/{wardKey} {
        allow read, write: if isKnownUser();
      }
    }

    match /archives_mhl/{archiveId} {
      allow read: if isKnownUser();
      allow create: if isKnownUser()
        && (isAdmin() || isSubadmin() || isOverallForWeekMhl(request.resource.data.weekId));
      allow update: if isAdmin() || isSubadmin();
      allow delete: if false;
    }
  }
}
